# Firebase web app config. Copy this file to .env and fill in the values
# from Project settings → Your apps → SDK setup and configuration.
# Restart `npm run dev` after changing this file.
# The Gemini API key is not stored here. Sign in, then paste it in Settings.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
